{
  "expo": {
    "name": "three_three",
    "slug": "three_three",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "threethree",
    "extra": {
      "googleClientId": {
        "android": "YOUR_GOOGLE_CLIENT_ID_ANDROID",
        "ios": "523125599576-h5dflih7l07v33bdsjgdsv5r7k7156i3.apps.googleusercontent.com",
        "web": "523125599576-22q0ankb0upvkagqlp7qquknp7gcdnbu.apps.googleusercontent.com"
      }
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buber.threethree"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.buber.threethree",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d055f204-0805-4fa9-8fa2-832464c185cf"
      }
    },
    "owner": "buber",
    "updates": {
      "url": "https://u.expo.dev/d055f204-0805-4fa9-8fa2-832464c185cf"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
