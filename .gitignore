# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (contains real secrets: DB password, Redis token, etc.)
.env
.env*.local

# typescript
*.tsbuildinfo

app-example

# native build artifacts (ios/ and android/ are tracked, like Nutrilabify's bare RN workflow)
ios/build/
ios/Pods/
android/build/
android/app/build/
android/.gradle/
android/local.properties
